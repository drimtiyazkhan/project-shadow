var string DELT4_1="AERONEU:4n-4s,ANTELOPUS:1r-24,ANURAS:3t-3x,APEX:3p-3y,APOLLOPIPE:3z-43,ARFIN:4n-4r,ARIHANTSUP:34-38|3j-3o,ASMS:33-4z,ATALREAL:34-38|3a-3h|4o-4s,AWHCL:39-3d,BUTTERFLY:49-4d,CROWN:3b-3f,CUPID:4k-4o,DEEDEV:21-27|2e-4i,DOLPHIN:2k-2q|2t-2x|30-36,DREDGECORP:3t-3x,EASEMYTRIP:1w-22,EUROPRATIK:2i-2n,EXICOM:3u-3z,FILATFASH:1n-1s,FINOPB:4v-4z,FIRSTCRY:30-36,FISCHER:44-4c|4e-4q,GALLANTT:2n-2s|37-3c,GANGAFORGE:48-4d,GICL:3f-3k,GOCOLORS:42-4q,GOKULAGRO:36-3a,GRAPHITE:33-38,GRMOVER:22-26|39-3f,GROWW:2o-2s,GSLSU:43-49,GUJALKALI:3e-3i,HARDWYN:3m-45,HSCL:43-48,IDEAFORGE:44-48|4b-4p,INDOTHAI:3z-4e,INFOBEAN:45-4a,IRISDOREME:3c-3k,IRMENERGY:3e-3q|3x-41,JAIPURKURT:2e-2p,JINDRILL:31-3a|3y-44,JPOLYINVST:2h-2m|2o-2s,KRN:2h-49|4b-4h|4v-4z,MANINDS:23-28,MASTERTR:3x-41,MCLOUD:4k-4o,MEESHO:31-35,MEGASTAR:49-4h,MICEL:2u-2y,MINDTECK:4d-4i,NARMADA:4i-4m,NEWGEN:2j-2n,NIITLTD:3y-47,OSIAHYPER:1r-1x,PANACEABIO:42-46,PANSARI:4h-4m,PCJEWELLER:34-38,POKARNA:28-2d,PRECWIRE:2b-2f,PREMEXPLN:3l-3p|3u-40|42-46,PVP:3u-3y,PWL:27-2b,QUADFUTURE:47-4b,RAMCOSYS:3x-4l|4p-4t|4v-4z,REGAAL:4d-4j,RGL:37-3d,RHETAN:4k-4z,ROLEXRINGS:2m-2q,RPSGVENT:2r-2x|38-3e,SAKSOFT:4c-4g,SASKEN:3r-3y,SILGO:4p-4u,SPARC:44-49,STLTECH:1x-21|27-2c,SUMEETINDS:3r-45,TARIL:29-2d,TEJASNET:1x-21,TICL:3c-3h,UMAEXPORTS:2i-2m,URAVIDEF:33-37,VERTOZ:1o-1z,VGL:4g-4l,VPRPL:1x-21,WEL:33-37,WEWIN:49-4e|4h-4l|4q-4w" // Tier 4 chunk 1 - 1.35x of 60-day baseline
var string DELT5_1="AERONEU:4n-4s,ANTELOPUS:1r-24,ANURAS:3t-3x,APEX:3q-3y,ARFIN:4n-4r,ARIHANTSUP:3k-3o,ASMS:33-4z,ATALREAL:4o-4s,DEEDEV:21-25|2f-4f,DOLPHIN:2t-2x|30-34,EUROPRATIK:2i-2n,EXICOM:3u-3z,FILATFASH:1n-1s,FINOPB:4v-4z,FISCHER:44-4c|4e-4k|4m-4q,GALLANTT:37-3c,GICL:3g-3k,GOCOLORS:46-4b|4d-4q,GRMOVER:22-26|39-3f,GSLSU:43-49,GUJALKALI:3e-3i,HARDWYN:3n-3x|3z-44,IDEAFORGE:44-48|4b-4n,INDOTHAI:3z-4e,IRISDOREME:3c-3g,IRMENERGY:3e-3q|3x-41,JAIPURKURT:2g-2p,JINDRILL:35-3a|3y-44,JPOLYINVST:2o-2s,KRN:2h-49|4b-4h,MCLOUD:4k-4o,MEGASTAR:49-4h,MICEL:2u-2y,NARMADA:4i-4m,NEWGEN:2j-2n,NIITLTD:41-45,OSIAHYPER:1r-1v,PANSARI:4h-4m,PREMEXPLN:3l-3p|42-46,PWL:27-2b,RAMCOSYS:42-4j|4p-4t|4v-4z,REGAAL:4f-4j,RHETAN:4k-4z,ROLEXRINGS:2m-2q,RPSGVENT:2t-2x|38-3d,SASKEN:3r-3v,SILGO:4p-4u,STLTECH:1x-21,SUMEETINDS:3r-45,TEJASNET:1x-21,UMAEXPORTS:2i-2m,URAVIDEF:33-37,VERTOZ:1o-1z,VGL:4g-4l,VPRPL:1x-21,WEL:33-37,WEWIN:4h-4l|4q-4u" // Tier 5 chunk 1 - 1.40x of 60-day baseline

var string GH = "Operator Style"
col_arrow  = input.color(#00E676, "Arrow color",           group=GH)
col_glow   = input.color(color.new(#00E676, 85), "Candle glow", group=GH)
col_bg     = input.color(color.new(#001a0a, 15), "Label bg",    group=GH)
show_glow  = input.bool(true,  "Show candle glow",         group=GH)
show_tip   = input.bool(true,  "Show names in tooltip",    group=GH)
arr_off    = input.float(0.4,  "Arrow gap (%)", minval=0.05, maxval=5.0, step=0.05, group=GH)

var string GD = "Delivery % Streak"
del_show     = input.bool(true, "Show Delivery Streak Highlight", group=GD)
del_show_lbl = input.bool(true, "Mark streak start with label",   group=GD)
del_t1_on  = input.bool(true, "Tier 1 (1.20x — Mild)", group=GD)
del_t1_col = input.color(color.new(#FFE08A, 80), "Tier 1 Color", group=GD)
del_t2_on  = input.bool(true, "Tier 2 (1.25x — Moderate)", group=GD)
del_t2_col = input.color(color.new(#FFA033, 80), "Tier 2 Color", group=GD)
del_t3_on  = input.bool(true, "Tier 3 (1.30x — Strong)", group=GD)
del_t3_col = input.color(color.new(#D6361B, 80), "Tier 3 Color", group=GD)
del_t4_on  = input.bool(true, "Tier 4 (1.35x — Very Strong)", group=GD)
del_t4_col = input.color(color.new(#A8231A, 80), "Tier 4 Color", group=GD)
del_t5_on  = input.bool(true, "Tier 5 (1.40x — Extreme)", group=GD)
del_t5_col = input.color(color.new(#6B0F0F, 80), "Tier 5 Color", group=GD)

var map<string,string> _m = map.new<string,string>()
var map<string,string> _dm1 = map.new<string,string>()
var map<string,string> _dm2 = map.new<string,string>()
var map<string,string> _dm3 = map.new<string,string>()
var map<string,string> _dm4 = map.new<string,string>()
var map<string,string> _dm5 = map.new<string,string>()

f_load(raw) =>
    string[] rws = str.split(raw, ",")
    for i = 0 to array.size(rws) - 1
        string r = array.get(rws, i)
        int a = str.pos(r, ":")
        if not na(a)
            string sym_  = str.substring(r, 0, a)
            string rest_ = str.substring(r, a + 1)
            int b = str.pos(rest_, ":")
            if not na(b)
                string dt_ = str.substring(rest_, 0, b)
                string cd_ = str.substring(rest_, b + 1)
                map.put(_m, sym_ + ":" + dt_, cd_)
    true

load_a() =>
    f_load(D1)
    f_load(D2)
    f_load(D3)
    f_load(D4)
    f_load(D5)
    true

load_b() =>
    f_load(D6)
    f_load(D7)
    f_load(D8)
    f_load(D9)
    f_load(D10)
    true

var _la = load_a()
var _lb = load_b()

f_load_tier(raw, m) =>
    string[] parts = str.split(raw, ",")
    for i = 0 to array.size(parts) - 1
        string p_ = array.get(parts, i)
        int a_ = str.pos(p_, ":")
        if not na(a_)
            map.put(m, str.substring(p_, 0, a_), str.substring(p_, a_ + 1))
    true

f_b36(s) =>
    string chars = "0123456789abcdefghijklmnopqrstuvwxyz"
    int acc = 0
    for i = 0 to str.length(s) - 1
        acc := acc * 36 + str.pos(chars, str.substring(s, i, i + 1))
    acc

var string[] DEL_DATE_ARR = str.split(DEL_DATES, ",")
var _dl1_1 = f_load_tier(DELT1_1, _dm1)
var _dl1_2 = f_load_tier(DELT1_2, _dm1)
var _dl2_1 = f_load_tier(DELT2_1, _dm2)
var _dl3_1 = f_load_tier(DELT3_1, _dm3)
var _dl4_1 = f_load_tier(DELT4_1, _dm4)
var _dl5_1 = f_load_tier(DELT5_1, _dm5)

sym = str.upper(syminfo.ticker)
bdt = str.format_time(time, "yyyyMMdd", "Asia/Kolkata")
v   = map.get(_m, sym + ":" + bdt)
bc  = na(v) ? 0 : array.size(str.split(v, "|"))
bn  = na(v) ? "" : v

del_idx = array.indexof(DEL_DATE_ARR, bdt)

f_get_range(rangestr, idx) =>
    int rst = na
    int ren = na
    if not na(rangestr) and idx >= 0
        string[] rs = str.split(rangestr, "|")
        for i = 0 to array.size(rs) - 1
            string pr   = array.get(rs, i)
            int dash    = str.pos(pr, "-")
            if not na(dash)
                int st = f_b36(str.substring(pr, 0, dash))
                int en = f_b36(str.substring(pr, dash + 1))
                if idx >= st and idx <= en
                    rst := st
                    ren := en
    [rst, ren]

del_v1 = map.get(_dm1, sym)
del_v2 = map.get(_dm2, sym)
del_v3 = map.get(_dm3, sym)
del_v4 = map.get(_dm4, sym)
del_v5 = map.get(_dm5, sym)

[del_s1, del_e1] = f_get_range(del_v1, del_idx)
[del_s2, del_e2] = f_get_range(del_v2, del_idx)
[del_s3, del_e3] = f_get_range(del_v3, del_idx)
[del_s4, del_e4] = f_get_range(del_v4, del_idx)
[del_s5, del_e5] = f_get_range(del_v5, del_idx)

del_hit1 = not na(del_s1)
del_hit2 = not na(del_s2)
del_hit3 = not na(del_s3)
del_hit4 = not na(del_s4)
del_hit5 = not na(del_s5)

del_tier_num = del_hit5 and del_t5_on ? 5 : del_hit4 and del_t4_on ? 4 : del_hit3 and del_t3_on ? 3 : del_hit2 and del_t2_on ? 2 : del_hit1 and del_t1_on ? 1 : 0
del_color    = del_tier_num==5?del_t5_col:del_tier_num==4?del_t4_col:del_tier_num==3?del_t3_col:del_tier_num==2?del_t2_col:del_tier_num==1?del_t1_col:na
del_act_s    = del_tier_num==5?del_s5:del_tier_num==4?del_s4:del_tier_num==3?del_s3:del_tier_num==2?del_s2:del_tier_num==1?del_s1:na
del_act_e    = del_tier_num==5?del_e5:del_tier_num==4?del_e4:del_tier_num==3?del_e3:del_tier_num==2?del_e2:del_tier_num==1?del_e1:na
del_is_start = del_tier_num > 0 and del_idx == del_act_s

bgcolor(del_show ? del_color : na, title="Delivery % Zone")

f_fmt_d(d8) =>
    str.substring(d8,0,4)+"-"+str.substring(d8,4,6)+"-"+str.substring(d8,6,8)

if del_show and del_show_lbl and del_is_start
    string ds_ = f_fmt_d(array.get(DEL_DATE_ARR, del_act_s))
    string de_ = f_fmt_d(array.get(DEL_DATE_ARR, del_act_e))
    string dm_ = str.tostring(1.15 + del_tier_num * 0.05, "#.00")
    string dt_ = "DELIVERY % STREAK\nStock: "+sym+"\nTier: "+str.tostring(del_tier_num)+" of 5 ("+dm_+"x baseline)\nStreak: "+ds_+" to "+de_
    label.new(x=bar_index, y=high*(1.0+arr_off/100.0), text="D"+str.tostring(del_tier_num), style=label.style_label_down, color=color.new(color.white,80), textcolor=color.black, size="tiny", tooltip=dt_, xloc=xloc.bar_index, yloc=yloc.price)

alertcondition(del_tier_num > 0, title="Delivery % Streak", message="Delivery% streak on {{ticker}}")

code_to_name(c) =>
    c == "J" ? "Jump Trading" : c == "Q" ? "QE Securities" : c == "N" ? "Junomoneta" : c == "K" ? "NK Securities" : c == "H" ? "HRTI" : c == "G" ? "Graviton" : c == "S" ? "Share India" : c == "E" ? "Elixir Wealth" : c == "D" ? "D3 Stock Vision" : c == "M" ? "Goldmine Stocks" : c == "C" ? "Microcurves" : c == "MS" ? "Musigma Securities" : c

xp(s) =>
    string[] parts = str.split(s, "|")
    string result = ""
    for i = 0 to array.size(parts) - 1
        result := result + code_to_name(array.get(parts, i)) + "\n"
    result

sz = bc <= 2 ? "tiny" : bc <= 4 ? "small" : bc <= 6 ? "normal" : bc <= 8 ? "large" : "huge"

if bc > 0
    y   = low * (1.0 - arr_off / 100.0)
    tip = show_tip ? "OPERATOR ACTIVITY\nStock: " + sym + "\nDate: " + str.format_time(time, "yyyy-MM-dd", "Asia/Kolkata") + "\nAccounts: " + str.tostring(bc) + " of 12\n" + xp(bn) : "Operator: " + str.tostring(bc) + " accounts"
    label.new(x=bar_index, y=y, text="▲" + str.tostring(bc), style=label.style_label_up, color=col_bg, textcolor=col_arrow, size=sz, tooltip=tip, xloc=xloc.bar_index, yloc=yloc.price)

bgcolor(show_glow and bc > 0 ? col_glow : na, title="Operator activity glow")
alertcondition(bc > 0, title="Operator Activity", message="Operator-linked activity on {{ticker}}")

var string GE = "EMA Settings"
ema1_on  = input.bool(true,  "EMA 1 On/Off", group=GE)
ema1_len = input.int(20, "EMA 1 Period",  group=GE, minval=1)
ema1_col = input.color(color.new(#2196F3, 0), "EMA 1 Color", group=GE)

ema2_on  = input.bool(true,  "EMA 2 On/Off", group=GE)
ema2_len = input.int(50, "EMA 2 Period",  group=GE, minval=1)
ema2_col = input.color(color.new(#FF9800, 0), "EMA 2 Color", group=GE)

ema3_on  = input.bool(true,  "EMA 3 On/Off", group=GE)
ema3_len = input.int(200, "EMA 3 Period",  group=GE, minval=1)
ema3_col = input.color(color.new(#F44336, 0), "EMA 3 Color", group=GE)

ema4_on  = input.bool(false,  "EMA 4 On/Off", group=GE)
ema4_len = input.int(100, "EMA 4 Period",  group=GE, minval=1)
ema4_col = input.color(color.new(#9C27B0, 0), "EMA 4 Color", group=GE)

ema5_on  = input.bool(false,  "EMA 5 On/Off", group=GE)
ema5_len = input.int(21, "EMA 5 Period",  group=GE, minval=1)
ema5_col = input.color(color.new(#00BCD4, 0), "EMA 5 Color", group=GE)

ema_src = input.source(close, "EMA Source", group=GE)

plot(ema1_on ? ta.ema(ema_src, ema1_len) : na, title="EMA 1", color=ema1_col, linewidth=1)
plot(ema2_on ? ta.ema(ema_src, ema2_len) : na, title="EMA 2", color=ema2_col, linewidth=1)
plot(ema3_on ? ta.ema(ema_src, ema3_len) : na, title="EMA 3", color=ema3_col, linewidth=2)
plot(ema4_on ? ta.ema(ema_src, ema4_len) : na, title="EMA 4", color=ema4_col, linewidth=1)
plot(ema5_on ? ta.ema(ema_src, ema5_len) : na, title="EMA 5", color=ema5_col, linewidth=1)
