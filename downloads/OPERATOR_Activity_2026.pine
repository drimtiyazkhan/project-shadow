// -- Style --------------------------------------------------------------------
col_arrow = input.color(#00E676, "Arrow color", group="Style")
col_glow  = input.color(color.new(#00E676, 85), "Candle glow", group="Style")
col_bg    = input.color(color.new(#001a0a, 15), "Label bg", group="Style")
show_glow = input.bool(true, "Show candle glow", group="Style")
show_tip  = input.bool(true, "Show names in tooltip", group="Style")
arr_off   = input.float(0.4, "Arrow gap (%)", minval=0.05, maxval=5.0, step=0.05, group="Style")

var map<string,string> _m = map.new<string,string>()

// -- Parser: loads one data chunk into the map --------------------------------
f_load(raw) =>
    string[] rws = str.split(raw, ",")
    for i = 0 to array.size(rws) - 1
        string r = array.get(rws, i)
        int a = str.pos(r, ":")
        if not na(a)
            string sym  = str.substring(r, 0, a)
            string rest = str.substring(r, a + 1)
            int b = str.pos(rest, ":")
            if not na(b)
                string dt = str.substring(rest, 0, b)
                string cd = str.substring(rest, b + 1)
                map.put(_m, sym + ":" + dt, cd)
    true

// -- Load wrappers (each groups 5 chunks to avoid Pine limits) ----------------
load_a() =>
    f_load(D1)
    f_load(D2)
    f_load(D3)
    f_load(D4)
    f_load(D5)
    true

load_b() =>
    f_load(D6)
    f_load(D7)
    f_load(D8)
    f_load(D9)
    true

// -- Trigger loading on first bar only -----------------------------------------
var _la = load_a()
var _lb = load_b()

// -- Per-bar O(1) map lookup ----------------------------------------------------
sym = str.upper(syminfo.ticker)
bdt = str.format_time(time, "yyyyMMdd", "Asia/Kolkata")
v   = map.get(_m, sym + ":" + bdt)
bc  = na(v) ? 0 : array.size(str.split(v, "|"))
bn  = na(v) ? "" : v

// -- Expand short codes to full account names ----------------------------------
code_to_name(c) =>
    c == "J" ? "Jump Trading" : c == "Q" ? "QE Securities" : c == "N" ? "Junomoneta" : c == "K" ? "NK Securities" : c == "H" ? "HRTI" : c == "G" ? "Graviton" : c == "S" ? "Share India" : c == "E" ? "Elixir Wealth" : c == "D" ? "D3 Stock Vision" : c == "M" ? "Goldmine Stocks" : c == "C" ? "Microcurves" : c == "MS" ? "Musigma Securities" : c

xp(s) =>
    string[] parts = str.split(s, "|")
    string result = ""
    for i = 0 to array.size(parts) - 1
        result := result + code_to_name(array.get(parts, i)) + "\n"
    result

// -- Arrow size scales with number of tracked accounts -------------------------
sz = bc <= 2 ? "tiny" : bc <= 4 ? "small" : bc <= 6 ? "normal" : bc <= 8 ? "large" : "huge"

if bc > 0
    y   = low * (1.0 - arr_off / 100.0)
    tip = show_tip ? "OPERATOR ACTIVITY\nStock: " + sym + "\nDate: " + str.format_time(time, "yyyy-MM-dd", "Asia/Kolkata") + "\nAccounts: " + str.tostring(bc) + " of 12\n" + xp(bn) : "Operator: " + str.tostring(bc) + " accounts"
    label.new(x=bar_index, y=y, text="▲" + str.tostring(bc), style=label.style_label_up, color=col_bg, textcolor=col_arrow, size=sz, tooltip=tip, xloc=xloc.bar_index, yloc=yloc.price)

bgcolor(show_glow and bc > 0 ? col_glow : na, title="Operator activity glow")
alertcondition(bc > 0, title="Operator Activity", message="Operator-linked activity on {{ticker}}")

// -- EMA Settings (customizable via Settings panel) ----------------------------
var string GE = "EMA Settings"
ema1_on  = input.bool(true,  "EMA 1 On/Off", group=GE)
ema1_len = input.int(20,     "EMA 1 Period",  group=GE, minval=1)
ema1_col = input.color(color.new(#2196F3, 0), "EMA 1 Color", group=GE)

ema2_on  = input.bool(true,  "EMA 2 On/Off", group=GE)
ema2_len = input.int(50,     "EMA 2 Period",  group=GE, minval=1)
ema2_col = input.color(color.new(#FF9800, 0), "EMA 2 Color", group=GE)

ema3_on  = input.bool(true,  "EMA 3 On/Off", group=GE)
ema3_len = input.int(200,    "EMA 3 Period",  group=GE, minval=1)
ema3_col = input.color(color.new(#F44336, 0), "EMA 3 Color", group=GE)

ema4_on  = input.bool(false, "EMA 4 On/Off", group=GE)
ema4_len = input.int(100,    "EMA 4 Period",  group=GE, minval=1)
ema4_col = input.color(color.new(#9C27B0, 0), "EMA 4 Color", group=GE)

ema5_on  = input.bool(false, "EMA 5 On/Off", group=GE)
ema5_len = input.int(21,     "EMA 5 Period",  group=GE, minval=1)
ema5_col = input.color(color.new(#00BCD4, 0), "EMA 5 Color", group=GE)

ema_src = input.source(close, "EMA Source", group=GE)

plot(ema1_on ? ta.ema(ema_src, ema1_len) : na, title="EMA 1", color=ema1_col, linewidth=1)
plot(ema2_on ? ta.ema(ema_src, ema2_len) : na, title="EMA 2", color=ema2_col, linewidth=1)
plot(ema3_on ? ta.ema(ema_src, ema3_len) : na, title="EMA 3", color=ema3_col, linewidth=2)
plot(ema4_on ? ta.ema(ema_src, ema4_len) : na, title="EMA 4", color=ema4_col, linewidth=1)
plot(ema5_on ? ta.ema(ema_src, ema5_len) : na, title="EMA 5", color=ema5_col, linewidth=1)
