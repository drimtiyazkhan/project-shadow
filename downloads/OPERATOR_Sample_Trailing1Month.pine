show_glow = input.bool(true, "Show candle glow", group="Style")
show_tip  = input.bool(true, "Show names in tooltip", group="Style")
arr_off   = input.float(0.4, "Arrow gap (%)", minval=0.05, maxval=5.0, step=0.05, group="Style")

