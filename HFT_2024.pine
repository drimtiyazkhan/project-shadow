6:G,ZAGGLE:4524:G,ZAGGLE:4731:G,ZAGGLE:4801:G,ZAGGLE:4816:G,ZAGGLE:4911:G,ZAGGLE:4912:G,ZAGGLE:4917:G,ZEEL:4109:GH,ZEEL:4110:G,ZEEL:4123:GH,ZEEL:4124:GH,ZEEL:4130:G,ZEEL:4209:GH,ZEEL:4220:H,ZEEL:4221:H,ZEEL:4827:G,ZEEL:4925:G,ZEEL:41119:G,ZEEMEDIA:4105:H,ZEEMEDIA:4108:H,ZEEMEDIA:4109:GHQ,ZEEMEDIA:4110:GH,ZEEMEDIA:4116:H,ZEEMEDIA:4118:GHQ,ZEEMEDIA:4119:GHQ,ZEEMEDIA:4123:GH,ZEEMEDIA:4124:H,ZEEMEDIA:4130:H,ZEEMEDIA:4208:H,ZEEMEDIA:4209:GHQ,ZEEMEDIA:4216:H,ZEEMEDIA:4220:H,ZEEMEDIA:4221:GH,ZEEMEDIA:4403:H,ZEEMEDIA:4626:H,ZEEMEDIA:4705:H,ZEEMEDIA:4923:H,ZEEMEDIA:4925:H,ZEEMEDIA:4926:HQ,ZEEMEDIA:4930:H,ZEEMEDIA:41003:H,ZEEMEDIA:41007:H,ZENSARTECH:4426:G,ZIMLAB:4424:GH,ZODIACLOTH:4625:K,ZUARI:4101:G,ZUARI:4102:G,ZUARI:4111:G,ZUARI:4112:GHQ,ZUARI:4120:G,ZUARI:4620:G,ZUARIIND:4110:G,ZUARIIND:4112:G,ZUARIIND:4221:G,ZUARIIND:4223:G,ZUARIIND:4624:G"

col_arrow=input.color(#00E676,"Arrow color",group="Style")
col_glow=input.color(color.new(#00E676,85),"Candle glow",group="Style")
col_bg=input.color(color.new(#001a0a,15),"Label bg",group="Style")
show_glow=input.bool(true,"Show candle glow",group="Style")
show_tip=input.bool(true,"Show names in tooltip",group="Style")
arr_off=input.float(0.4,"Arrow gap (%)",minval=0.05,maxval=5.0,step=0.05,group="Style")

var map<string,string> _m=map.new<string,string>()

f_parse(raw)=>
    string[] rws=str.split(raw,",")
    for i=0 to array.size(rws)-1
        string r=array.get(rws,i)
        int a=str.pos(r,":")
        if not na(a)
            string sym=str.substring(r,0,a)
            string rest=str.substring(r,a+1)
            int b=str.pos(rest,":")
            if not na(b)
                string cdt=str.substring(rest,0,b)
                string cd=str.substring(rest,b+1)
                string yr=str.substring(cdt,0,1)
                string fy=yr=="4"?"2024":yr=="5"?"2025":"2026"
                string dt=fy+str.substring(cdt,1)
                map.put(_m,sym+":"+dt,cd)
    true

load_a()=>
    f_parse(D1)
    f_parse(D2)
    f_parse(D3)
    f_parse(D4)
    f_parse(D5)
    f_parse(D6)
    f_parse(D7)
    f_parse(D8)
    true

load_b()=>
    f_parse(D9)
    f_parse(D10)
    f_parse(D11)
    f_parse(D12)
    f_parse(D13)
    true

var _la=load_a()
var _lb=load_b()

xp(s)=>
    string r=s
    r:=str.replace_all(r,"J","Jump Trading,")
    r:=str.replace_all(r,"Q","QE Securities,")
    r:=str.replace_all(r,"N","Junomoneta,")
    r:=str.replace_all(r,"K","NK Securities,")
    r:=str.replace_all(r,"H","HRTI,")
    r:=str.replace_all(r,"G","Graviton,")
    r:=str.replace_all(r,"S","Share India,")
    r:=str.replace_all(r,"E","Elixir Wealth,")
    r:=str.replace_all(r,"D","D3 Stock Vision,")
    r:=str.replace_all(r,"M","Goldmine Stocks,")
    r:=str.replace_all(r,"C","Microcurves,")
    str.replace_all(r,",","\n")

sym=str.upper(syminfo.ticker)
bdt=str.format_time(time,"yyyyMMdd","Asia/Kolkata")
v=map.get(_m,sym+":"+bdt)
bc=na(v)?0:str.length(v)
bn=na(v)?"":v

sz=bc<=2?"tiny":bc<=4?"small":bc<=6?"normal":bc<=8?"large":bc<=10?"huge":"enormous"

if bc>0
    y=low*(1.0-arr_off/100.0)
    tip=show_tip?"HFT BULK DEAL\nStock: "+sym+"\nDate: "+str.format_time(time,"yyyy-MM-dd","Asia/Kolkata")+"\nTraders: "+str.tostring(bc)+" of 11\n"+xp(bn):"HFT: "+str.tostring(bc)+" traders"
    label.new(x=bar_index,y=y,text="▲"+str.tostring(bc),style=label.style_label_up,color=col_bg,textcolor=col_arrow,size=sz,tooltip=tip,xloc=xloc.bar_index,yloc=yloc.price)

bgcolor(show_glow and bc>0?col_glow:na,title="HFT candle glow")
alertcondition(bc>0,title="HFT Bulk Deal",message="HFT activity on {{ticker}}")
